VITE_SHOPIFY_STORE_DOMAIN=crystalbaaz.myshopify.com
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN="281a71c5808bef1d3783448b3e430411"
VITE_SHOPIFY_API_VERSION=2026-10
# Production always uses Shopify. Set preview only for local development with workbook data.
VITE_CATALOG_SOURCE=shopify
# Public HTTPS frontend origin for share links. Override if the storefront domain changes.
VITE_PUBLIC_SITE_URL=https://orbisdata00.github.io/crystal-baaz/
# Customer Account API uses a public client ID (never add a client secret here).
# Register these exact HTTPS callback/logout URLs and this app origin in Shopify Admin.
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=
VITE_SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URI=
# Checkout stays disabled unless the merchant has approved setup and testing.
VITE_SHOPIFY_CHECKOUT_ENABLED=false
