VITE_SHOPIFY_STORE_DOMAIN=crystalbaaz.myshopify.com
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-10

VITE_CATALOG_SOURCE=shopify
VITE_PUBLIC_SITE_URL=https://orbisdata00.github.io/crystal-baaz/
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://orbisdata00.github.io/crystal-baaz/
VITE_SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URI=https://orbisdata00.github.io/crystal-baaz/
VITE_CHECKOUT_PROVIDER=disabled
# Local manual Standard Checkout testing only: set to razorpay_test in .env.local.
# Production builds always disable this provider.
VITE_SHOPIFY_CHECKOUT_ENABLED=false
VITE_RAZORPAY_MAGIC_ENABLED=false
VITE_RAZORPAY_KEY_ID=
# Local backend only. Never set this to localhost in a deployed storefront.
VITE_RAZORPAY_BACKEND_URL=http://localhost:3001

# Backend-only settings belong in backend/.env, never in VITE_* variables.
# RAZORPAY_MODE=test
# RAZORPAY_MAGIC_ENABLED=false
# RAZORPAY_MAGIC_AUTHORIZED=false
# RAZORPAY_MAGIC_TEST_MODE_SUPPORTED=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SHOPIFY_STORE_DOMAIN=crystalbaaz.myshopify.com
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# STOREFRONT_ORIGIN=http://localhost:5173
# PORT=3001
